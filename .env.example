# OpenAI — editorial pipeline only. Never commit this file.
# Copy to .env and paste your key. The user PWA does not read this.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# 아래는 파일럿 서버용. 없어도 앱은 정상 동작한다. docs/pilot-setup.md 참고.
# 저장소 (Upstash Redis를 Vercel에 연결하면 자동 주입된다)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 이벤트 회수용 토큰
EXPORT_TOKEN=

# 알림 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# 클라이언트 번들에 들어가는 값. VAPID_PUBLIC_KEY와 같은 값만 넣는다.
VITE_VAPID_PUBLIC_KEY=
