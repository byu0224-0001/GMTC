{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron-nudge", "schedule": "0 0 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 1 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 2 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 3 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 4 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 5 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 6 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 7 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 8 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 9 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 10 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 11 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 12 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 13 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 14 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 15 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 16 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 17 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 18 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 19 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 20 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 21 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 22 * * *" },
    { "path": "/api/cron-nudge", "schedule": "0 23 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data:; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
